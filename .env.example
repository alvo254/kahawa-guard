# Copy to .env and fill in. Never commit .env with values.

# --- profile and pack ---
PROFILE=naked
PACK=coffee

# --- model provider: mistral | ollama ---
LLM_PROVIDER=mistral

# Mistral La Plateforme (set a spend limit on the key)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
GUARDRAIL_MODEL=moderation_llm_v2

# Local Ollama on the host. 172.18.0.1 is the usual kind Docker network gateway;
# confirm with: docker network inspect kind
OLLAMA_BASE_URL=http://172.18.0.1:11434/v1
OLLAMA_CHAT_MODEL=mistral-small3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Embedding width MUST match the vector(n) column in data/schema.sql.
# 1024 for mistral-embed, 768 for nomic-embed-text.
EMBED_DIM=1024

# --- Shieldstral expert guard (runs outside the cluster, on a GPU box) ---
SHIELDSTRAL_URL=
SHIELDSTRAL_API_KEY=
SHIELDSTRAL_MODE=cached

# --- data ---
DATABASE_URL=postgresql://kahawa:kahawa@postgres.data.svc.cluster.local:5432/kahawa
REDIS_URL=redis://redis.data.svc.cluster.local:6379/0

# --- MCP ---
# JSON list of {name, url, pin}. pin is the sha256 of the sorted tools/list result.
MCP_SERVERS=[{"name":"kahawa-tools","url":"http://kahawa-tools.tools.svc.cluster.local:8000/mcp","pin":""}]
N8N_MCP_TOKEN=

# --- admin ---
ADMIN_TOKEN=
PACKS_DIR=/etc/kahawa/packs

# --- SMS (optional, Africa's Talking sandbox) ---
AT_USERNAME=sandbox
AT_API_KEY=
