{
  "name": "change_payout",
  "nodes": [
    {
      "parameters": {
        "path": "change-payout",
        "toolDescription": "Update a member's payout account reference by grower code. Call this ONLY after the gateway's tool gate has released it — this workflow trusts whatever grower_code and account_ref it is given, which is why nothing upstream of here is allowed to call it without the gateway having already collected the member's PIN and an officer's approval.",
        "parametersSchema": {
          "type": "object",
          "required": ["grower_code", "account_ref"],
          "properties": {
            "grower_code": { "type": "string" },
            "account_ref": { "type": "string" }
          }
        }
      },
      "id": "11111111-1111-4111-8111-111111111101",
      "name": "MCP Server Trigger",
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE members SET payout_account_ref = $2 WHERE grower_code = $1 RETURNING id, grower_code, payout_account_ref;",
        "options": { "queryReplacement": "={{ [$json.grower_code, $json.account_ref] }}" }
      },
      "id": "11111111-1111-4111-8111-111111111102",
      "name": "Update payout account",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 300],
      "credentials": { "postgres": { "id": "kahawa-postgres", "name": "Kahawa Postgres" } }
    },
    {
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "to": "={{ $('MCP Server Trigger').item.json.phone }}",
        "message": "=Your Kahawa Guard payout account was changed to {{ $json.payout_account_ref }}. If you did not request this, contact the cooperative office immediately."
      },
      "id": "11111111-1111-4111-8111-111111111103",
      "name": "Notify member by SMS",
      "type": "n8n-nodes-base.africasTalking",
      "typeVersion": 1,
      "position": [680, 300],
      "credentials": { "africasTalkingApi": { "id": "kahawa-at", "name": "Africa's Talking (sandbox)" } }
    }
  ],
  "connections": {
    "MCP Server Trigger": {
      "main": [[{ "node": "Update payout account", "type": "main", "index": 0 }]]
    },
    "Update payout account": {
      "main": [[{ "node": "Notify member by SMS", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "pinData": {},
  "versionId": "1",
  "meta": { "templateCredsSetupCompleted": true }
}
