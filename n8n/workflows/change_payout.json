{
  "id": "kgChangePayout01",
  "name": "kahawa: change_payout",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "grower_code",
              "type": "string"
            },
            {
              "name": "account_ref",
              "type": "string"
            }
          ]
        }
      },
      "id": "11111111-1111-4111-8111-111111111101",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE members SET payout_account_ref = $2 WHERE grower_code = $1 RETURNING id, grower_code, payout_account_ref, phone_e164;",
        "options": {
          "queryReplacement": "={{ [$json.grower_code, $json.account_ref] }}"
        }
      },
      "id": "11111111-1111-4111-8111-111111111102",
      "name": "Update payout account",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "kahawa-postgres",
          "name": "Kahawa Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sandbox.africastalking.com/version1/messaging",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "sandbox"
            },
            {
              "name": "to",
              "value": "={{ $json.phone_e164 }}"
            },
            {
              "name": "message",
              "value": "=Your Kahawa Guard payout account was changed to {{ $json.payout_account_ref }}. If you did not request this, contact the cooperative office immediately."
            }
          ]
        }
      },
      "id": "11111111-1111-4111-8111-111111111103",
      "name": "Notify member by SMS",
      "notes": "Africa's Talking has no dedicated n8n node — this calls its REST API directly. The apiKey credential (name 'apiKey', value from AT_API_KEY) is created once in n8n's own Credentials UI; it is never exported with the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "kahawa-at-header",
          "name": "Africa's Talking apiKey header"
        }
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Update payout account",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update payout account": {
      "main": [
        [
          {
            "node": "Notify member by SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "2",
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
