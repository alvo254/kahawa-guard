{
  "id": "kgSendSms0000001",
  "name": "kahawa: send_sms",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "grower_code",
              "type": "string"
            },
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      },
      "id": "33333333-3333-4333-8333-333333333301",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT phone_e164 FROM members WHERE grower_code = $1;",
        "options": {
          "queryReplacement": "={{ [$json.grower_code] }}"
        }
      },
      "id": "33333333-3333-4333-8333-333333333302",
      "name": "Look up member",
      "notes": "phone_e164, not phone_hash — the hash is a one-way SHA256 and cannot be dialed. Only this workflow's Postgres query touches phone_e164; the gateway itself never selects it.",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "kahawa-postgres",
          "name": "Kahawa Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sandbox.africastalking.com/version1/messaging",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "sandbox"
            },
            {
              "name": "to",
              "value": "={{ $json.phone_e164 }}"
            },
            {
              "name": "message",
              "value": "={{ $('Start').item.json.message }}"
            }
          ]
        }
      },
      "id": "33333333-3333-4333-8333-333333333303",
      "name": "Send SMS",
      "notes": "Africa's Talking has no dedicated n8n node — this calls its REST API directly. The apiKey credential (name 'apiKey', value from AT_API_KEY) is created once in n8n's own Credentials UI; it is never exported with the workflow.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "kahawa-at-header",
          "name": "Africa's Talking apiKey header"
        }
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Look up member",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Look up member": {
      "main": [
        [
          {
            "node": "Send SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "2",
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
